{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "deckpilot-ai-frontend",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-03",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "deckpilot-ai-frontend"
    }
  ],
  "vars": {
    "NEXT_PUBLIC_API_BASE_URL": "https://deckpilot-ai.duckdns.org/api/v1"
  },
  "observability": {
    "enabled": true
  }
}
