# ==============================================================================
# DeckPilotAI Frontend - Production Environment Variables (.env.production)
# ==============================================================================
# In production, Next.js embeds NEXT_PUBLIC_* variables into the browser bundle.
# Set this to your live HTTPS FastAPI backend endpoint ending with /api/v1
# (e.g. your Render web service URL or your custom API domain).
# ==============================================================================

NEXT_PUBLIC_API_BASE_URL=https://deckpilot-ai-backend.onrender.com/api/v1
